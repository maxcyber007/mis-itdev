# ==============================================================================
# ตัวแปรสภาพแวดล้อมของระบบ MIS
#
# - รันในเครื่อง: คัดลอกไฟล์นี้เป็น .env.local แล้วแก้ค่าให้ตรงกับฐานข้อมูลของคุณ
# - รันบน Portainer: นำคู่ค่าเหล่านี้ไปกรอกในช่อง Environment variables ของ Stack
# ==============================================================================

# ---- ฐานข้อมูล MySQL / MariaDB ----
# เมื่อรันเป็น container ให้ใส่ "ชื่อ container ของ MySQL" ที่อยู่เครือข่ายเดียวกัน
# เมื่อรันในเครื่องโดยตรง ให้ใช้ 127.0.0.1
#
# สำคัญ: DB_PORT ต้องเป็น "พอร์ตภายในของ container ฐานข้อมูล" (ปกติคือ 3306 เสมอ)
# ไม่ใช่พอร์ตที่ map ออกสู่โฮสต์ (เช่น 3308) — พอร์ต map ออกใช้ต่อจากนอก Docker
# network เท่านั้น ถ้า mis-app กับ MySQL อยู่เครือข่าย Docker เดียวกัน ให้ใช้ 3306 เสมอ
DB_HOST=mysql
DB_PORT=3306
DB_USER=mis_user
DB_PASSWORD=เปลี่ยนรหัสผ่านนี้
DB_NAME=mis_cmtc
DB_POOL_SIZE=10
# ผู้ใช้นี้ต้องมีสิทธิ์ CREATE เพื่อให้ระบบสร้างฐานข้อมูล/ตารางเองอัตโนมัติ
# (ดูรายละเอียดคำสั่ง GRANT ที่ต้องใช้ใน README.md หัวข้อ "ฐานข้อมูล")

# ---- ค่าลับสำหรับลงลายเซ็น session (จำเป็น) ----
# สร้างด้วยคำสั่ง: openssl rand -hex 32
AUTH_SECRET=เปลี่ยนเป็นค่าสุ่มความยาวอย่างน้อย 32 ไบต์

# ---- รหัสผ่านของบัญชีตั้งต้น ----
# ใช้เฉพาะตอนที่ระบบสร้างตารางครั้งแรก (ตาราง users ยังว่าง) เท่านั้น
SEED_ADMIN_PASSWORD=admin1234
SEED_STAFF_PASSWORD=staff1234
SEED_USER_PASSWORD=user1234

# ---- การรันด้วย Docker / Portainer ----
# พอร์ตบนเครื่องโฮสต์ที่จะเปิดให้เข้าใช้งานระบบ
APP_PORT=3000
# ชื่อเครือข่าย Docker ที่ MySQL container ของคุณใช้อยู่
# ตรวจได้ด้วย: docker inspect <ชื่อ container ของ mysql> -f '{{json .NetworkSettings.Networks}}'
MIS_NETWORK=mysql_default
TZ=Asia/Bangkok

# ---- ใช้เฉพาะกับ docker-compose.standalone.yml ----
DB_ROOT_PASSWORD=เปลี่ยนรหัสผ่าน root
